enum AlbumLocation {
  LIBRARY
  DISCOVER
}

enum DiscoverStatus {
  ACTIVE
  LIKED
  MOVED
  DELETED
}

enum ListenSource {
  LIBRARY
  DISCOVERY
  DISCOVERY_KEPT
  SUBSONIC
}

/// One row per user per release: its presence means that user closed the release
/// window for that version, and `dismissedAt` says when.
model ReleaseAcknowledgement {
  id          String   @id @default(cuid())
  userId      String
  /// The release this acknowledges, e.g. "1.10.1". Compared as a string; the
  /// server decides which releases are pending, never the client.
  version     String
  dismissedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId])
}

/// A decision on one opt-in. Closing the release window without touching a toggle
/// still writes a row, with `decidedBy = DISMISSED` and the default value (always
/// off), so there is no third state to read and opt-in counts have a real denominator.
model ReleaseChoice {
  id        String          @id @default(cuid())
  userId    String
  version   String
  /// Stable identifier for the thing being consented to, e.g.
  /// "social.network", "commons.contribute". Survives copy changes.
  key       String
  enabled   Boolean         @default(false)
  decidedBy ChoiceDecidedBy @default(DISMISSED)
  decidedAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@index([key])
}

enum ChoiceDecidedBy {
  /// The user moved the toggle themselves.
  EXPLICIT
  /// The window was closed without answering. Recorded at the default.
  DISMISSED
}

/// A track the play-history audit has been told to stop flagging. Ignoring is per
/// track, not per play, so it keeps applying as new plays arrive; an ignored track
/// still counts plays like any other and is simply never raised again.
model PlayAuditIgnore {
  userId    String
  trackId   String
  ignoredAt DateTime @default(now())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
}

/// One answer per track per stage: `stage` is the question ("recording", "analysis",
/// "embedding", "fingerprint"), `status` its answer (pending | working | done | failed |
/// blocked) and `evidence` the probe behind it. `failureClass` is the classifier's
/// Disposition (DAMAGED | UNSUPPORTED | MULTICANNEL | INCONCLUSIVE), null while nothing has failed.
model TrackStage {
  id               String    @id @default(cuid())
  trackId          String
  /// Question being answered: "fingerprint" | "recording" | "analysis" | "embedding".
  stage            String
  status           String    @default("pending")
  /// Which producer answers this stage ("analyzer", "clap", "musicbrainz"…).
  source           String?
  /// Claims made: each claim's job id carries it (`claimOf`). Retries are counted by `failures`.
  attempt          Int       @default(0)
  /// Times a claim was re-offered because its lease expired without an answer.
  /// That never consumes an attempt; at 3 the record closes.
  redelivered      Int       @default(0)
  /// Reported failures of this question; only these use up retries (STAGE_RETRY_CAP).
  failures         Int       @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  failureClass     String?
  /// False means terminal: never offered again until a human re-decides it.
  retryable        Boolean   @default(true)
  /// When a retry becomes due. Null on a first, unanswered attempt.
  nextRetryAt      DateTime?
  /// How the answer was reached: probe command, return code, stderr, decoder,
  /// sample rate, channels, duration.
  evidence         Json?
  startedAt        DateTime?
  finishedAt       DateTime?
  /// When a human decided this answer was final, and who.
  decidedAt        DateTime?
  decidedBy        String?
  track            Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /// One answer per stage per track — this is what stops the same question
  /// being answered twice into two different rows.
  @@unique([trackId, stage])
  /// What the stage queue actually queries: "give me the next work per stage".
  @@index([stage, status, nextRetryAt])
  @@map("TrackStage")
}

/// One record per *source*, so a paused source is one row rather than one per waiting track.
/// A source pause is a fact about MusicBrainz/AcoustID/
/// ListenBrainz, not about 2,787 tracks that all happen to be waiting on it.
model SourceAttempt {
  id               String    @id @default(cuid())
  /// "musicbrainz" | "acoustid" | "listenbrainz" | …
  source           String    @unique
  status           String    @default("pending")
  attempt          Int       @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  failureClass     String?
  retryable        Boolean   @default(true)
  nextRetryAt      DateTime?
  evidence         Json?
  startedAt        DateTime?
  finishedAt       DateTime?
  decidedAt        DateTime?
  decidedBy        String?

  @@map("SourceAttempt")
}
